    android:color="#3000A884">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15233138" />
            <stroke
                android:width="1.5dp"
                android:color="#00A884" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>

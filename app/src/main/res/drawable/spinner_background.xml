<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp-Style Spinner Background with Frame Border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border frame -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#4D6878" />
            <corners android:radius="8dp" />
            <padding
                android:left="12dp"
                android:right="32dp"
                android:top="0dp"
                android:bottom="0dp" />
        </shape>
    </item>
    <!-- Dropdown Arrow -->
    <item
        android:drawable="@drawable/ic_dropdown_arrow"
        android:gravity="end|center_vertical"
        android:width="14dp"
        android:height="14dp"
        android:right="10dp" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2A3A" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#32E0C4" />
            <padding
                android:left="2dp"
                android:right="18dp"
                android:top="0dp"
                android:bottom="0dp" />
        </shape>
    </item>
    <!-- Dropdown Arrow -->
    <item
        android:drawable="@drawable/ic_dropdown_arrow"
        android:gravity="end|center_vertical"
        android:width="12dp"
        android:height="12dp"
        android:right="2dp" />
</layer-list>

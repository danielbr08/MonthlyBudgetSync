<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="@color/colorBackgroundGradientStart"
                android:endColor="@color/colorBackgroundGradientEnd"
                android:angle="135" />
        </shape>
    </item>
    
    <!-- Subtle pattern overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:gradientRadius="600dp"
                android:centerX="0.9"
                android:centerY="0.1" />
        </shape>
    </item>
    
    <!-- Secondary glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#150D7377"
                android:endColor="#00000000"
                android:gradientRadius="400dp"
                android:centerX="0.1"
                android:centerY="0.8" />
        </shape>
    </item>
</layer-list>

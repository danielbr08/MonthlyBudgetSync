<?xml version="1.0" encoding="utf-8"?>
<!-- Professional Input Field Background with Enhanced States -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed/Activated State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#405B6B" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#00A884" />
        </shape>
    </item>
    
    <!-- Focused State - Accent Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A5565" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#00A884" />
        </shape>
    </item>
    
    <!-- Enabled State (Default) -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A5565" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Disabled State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A3B45" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    
</selector>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    tools:context=".ui.ContactUsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl"
            android:paddingTop="@dimen/spacing_xxxl"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Page Title -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/contact_us"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="We'd love to hear from you"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/spacing_xxl" />

            <!-- Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="@dimen/spacing_xxl">

                <!-- Subject Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/subject"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/subjectET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Message Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xxl"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/message"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/messageET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textMultiLine"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md"
                        android:minLines="6"
                        android:gravity="top|start" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:onClick="saveMessage"
                    android:text="@string/submit"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/corner_md"
                    app:backgroundTint="@color/colorButtonPrimary"
                    app:rippleColor="@color/colorPrimaryLight"
                    android:elevation="@dimen/card_elevation"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/colorWhite" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_auth"
    tools:context=".login.Register">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl"
            android:paddingTop="@dimen/spacing_xxxl"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_xxxl">

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="@dimen/logo_height_sm"
                    android:layout_height="@dimen/logo_height_sm"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/budget"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <!-- Title -->
                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aclonica"
                    android:text="@string/create_new_account"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_xl"
                    android:letterSpacing="0.02"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join Monthly Budget"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />

            </LinearLayout>

            <!-- Registration Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="@dimen/spacing_xl">

                <!-- Full Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/full_name"
                    app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:startIconTint="@color/colorTextSecondary"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textPersonName"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/email"
                    app:startIconDrawable="@android:drawable/sym_action_email"
                    app:startIconTint="@color/colorTextSecondary"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/Email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/password"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/colorTextSecondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/colorTextSecondary"
                    app:errorEnabled="true"
                    app:helperText="Minimum 6 characters"
                    app:helperTextTextColor="@color/colorTextMuted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textPassword"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/retype_password"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/colorTextSecondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/colorTextSecondary"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reTypePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textPassword"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Input (Optional) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/phone"
                    app:startIconDrawable="@android:drawable/ic_menu_call"
                    app:startIconTint="@color/colorTextSecondary"
                    app:helperText="Optional"
                    app:helperTextTextColor="@color/colorTextMuted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="phone"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Register Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:text="@string/register"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="@font/aclonica"
                    app:cornerRadius="@dimen/corner_md"
                    app:backgroundTint="@color/colorButtonPrimary"
                    app:rippleColor="@color/colorPrimaryLight"
                    android:elevation="@dimen/card_elevation" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:visibility="invisible"
                android:indeterminateTint="@color/colorPrimaryLight" />

            <!-- Login Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_xxl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already Registered? "
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/createText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login Here"
                    android:textColor="@color/colorLink"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"
                    android:padding="@dimen/spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

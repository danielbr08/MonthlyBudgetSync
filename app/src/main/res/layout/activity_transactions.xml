<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    tools:context=".ui.TransactionsActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout_transactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="60dp">

                <!-- Page Title -->
                <TextView
                    android:id="@+id/transactionsTitleLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="@string/transactions"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="16dp" />

                <!-- Filter Card - Single Row with Category, Active, and Total -->
                <LinearLayout
                    android:id="@+id/Cat_TotalLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_glass"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <!-- Category Spinner -->
                    <Spinner
                        android:id="@+id/categorySpinnerTransactions"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="0.35"
                        android:background="@drawable/spinner_background"
                        android:popupBackground="@drawable/spinner_dropdown_background" />

                    <!-- Active Checkbox -->
                    <LinearLayout
                        android:id="@+id/stornoFilterLL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical">

                        <CheckBox
                            android:id="@+id/transactionsFilterCB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_transactions"
                            android:checked="true"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp"
                            app:buttonTint="@color/colorPrimary" />

                    </LinearLayout>

                    <!-- Total Section -->
                    <LinearLayout
                        android:id="@+id/totalLL"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/textViewTotalTransactionsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text='@string/total'
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextSecondary" />

                        <TextView
                            android:id="@+id/tv_total_transactions_top"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/zero"
                            android:textDirection="ltr"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPositive"
                            tools:targetApi="jelly_bean_mr1" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Transactions List Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_glass"
                    android:padding="8dp">

                    <!-- Headers Row -->
                    <LinearLayout
                        android:id="@+id/headersTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/header_background"
                        android:minHeight="44dp"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:weightSum="1"
                        android:baselineAligned="false"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/trn_id"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.11"
                            android:gravity="center_vertical"
                            android:text="@string/id"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textDirection="locale"
                            android:singleLine="true"
                            tools:targetApi="jelly_bean_mr1" />

                        <TextView
                            android:id="@+id/trn_category"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.16"
                            android:gravity="center_vertical"
                            android:text="@string/category"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textDirection="locale"
                            android:singleLine="true"
                            tools:targetApi="jelly_bean_mr1" />

                        <TextView
                            android:id="@+id/trn_store"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.19"
                            android:gravity="center_vertical"
                            android:text="@string/store"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textDirection="locale"
                            android:singleLine="true"
                            tools:targetApi="jelly_bean_mr1" />

                        <TextView
                            android:id="@+id/trn_charge_date"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.21"
                            android:gravity="center_vertical"
                            android:text="@string/charge_date"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textDirection="ltr"
                            android:singleLine="true"
                            tools:targetApi="jelly_bean_mr1" />

                        <TextView
                            android:id="@+id/trn_payment_method"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.18"
                            android:gravity="center"
                            android:text="@string/payment_method"
                            android:textAlignment="center"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textDirection="locale"
                            android:singleLine="true"
                            tools:ignore="RtlCompat"
                            tools:targetApi="jelly_bean_mr1" />

                        <TextView
                            android:id="@+id/trn_price"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.15"
                            android:gravity="center_vertical|end"
                            android:text="@string/price"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textAlignment="viewEnd"
                            android:textDirection="ltr"
                            android:singleLine="true"
                            tools:ignore="RtlCompat"
                            tools:targetApi="jelly_bean_mr1" />

                    </LinearLayout>

                    <!-- Transactions List -->
                    <LinearLayout
                        android:id="@+id/LLTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/transactions_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:orientation="vertical"
                            android:overScrollMode="never" />

                    </LinearLayout>

                    <!-- No Transactions Message -->
                    <LinearLayout
                        android:id="@+id/ll_no_trans_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_transactions_exists"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="16sp"
                            android:textAlignment="center" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- AdView (hidden by default as in original) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adSize="BANNER"
            app:adUnitId="@string/admob_banner_unit_id" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

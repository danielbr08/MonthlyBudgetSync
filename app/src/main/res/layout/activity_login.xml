<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_auth"
    tools:context=".login.Login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl"
            android:paddingTop="@dimen/spacing_huge"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Logo Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_huge">

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="@dimen/logo_height_md"
                    android:layout_height="@dimen/logo_height_md"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/budget"
                    android:layout_marginBottom="@dimen/spacing_lg" />

                <!-- Title -->
                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aclonica"
                    android:text="@string/login"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_title"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_budget"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />

            </LinearLayout>

            <!-- Login Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="@dimen/spacing_xxl">

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/email"
                    app:startIconDrawable="@android:drawable/sym_action_email"
                    app:startIconTint="@color/colorTextSecondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/Email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md"
                        android:paddingTop="@dimen/spacing_lg"
                        android:paddingBottom="@dimen/spacing_lg" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="@string/password"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/colorTextSecondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/colorTextSecondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textPassword"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_md"
                        android:paddingTop="@dimen/spacing_lg"
                        android:paddingBottom="@dimen/spacing_lg" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember Me & Forgot Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_xxl">

                    <CheckBox
                        android:id="@+id/rememberMeCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/remember_me"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_sm"
                        app:buttonTint="@color/colorPrimaryLight" />

                    <TextView
                        android:id="@+id/forgotPasswordTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="openForgotPassword"
                        android:padding="@dimen/spacing_xs"
                        android:text="@string/forgot_password"
                        android:textColor="@color/colorLink"
                        android:textSize="@dimen/text_sm"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

                <!-- Login Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:text="@string/login"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="@font/aclonica"
                    app:cornerRadius="@dimen/corner_md"
                    app:backgroundTint="@color/colorButtonPrimary"
                    app:rippleColor="@color/colorPrimaryLight"
                    android:elevation="@dimen/card_elevation" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="invisible"
                android:indeterminateTint="@color/colorPrimaryLight" />

            <!-- Create Account Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_xxxl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Here? "
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/createText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="@color/colorLink"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"
                    android:padding="@dimen/spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

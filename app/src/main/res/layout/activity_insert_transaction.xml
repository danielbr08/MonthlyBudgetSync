<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    tools:context=".ui.InsertTransactionActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/LLMainInsertTranssaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="60dp">

            <!-- Page Title -->
            <TextView
                android:id="@+id/inserTransactionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/insert_transaction"
                android:textColor="@color/colorTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="20dp" />

            <!-- Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="18dp"
                android:layout_marginBottom="12dp">

                <!-- Category Spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/chooseCategoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/categorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/spinner_background"
                        android:popupBackground="@drawable/spinner_dropdown_background" />

                </LinearLayout>

                <!-- Payment Method Spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/choosePaymenMethodtLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/paymentMethodSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/spinner_background"
                        android:popupBackground="@drawable/spinner_dropdown_background" />

                </LinearLayout>

                <!-- Charge Date Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/payDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/charge_date"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/payDatePlainText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="date"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        tools:targetApi="o" />

                </LinearLayout>

                <!-- Store Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/shopLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/store"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <AutoCompleteTextView
                        android:id="@+id/shopAutoCompleteTextView"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:hint="@string/store"
                        android:textColorHint="@color/colorInputHint"
                        android:gravity="center_vertical" />

                </LinearLayout>

                <!-- Price Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/transactionPriceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/price"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/transactionPricePlainText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned|numberDecimal"
                        android:textDirection="ltr"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:hint="0.00"
                        android:textColorHint="@color/colorInputHint"
                        android:gravity="center_vertical"
                        tools:targetApi="jelly_bean_mr1" />

                </LinearLayout>

                <!-- Discount Section -->
                <LinearLayout
                    android:id="@+id/discountSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <CheckBox
                            android:id="@+id/discountCheckBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/discount"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="44dp"
                            app:buttonTint="@color/colorPrimary" />

                        <LinearLayout
                            android:id="@+id/discountInputLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/discountPercentEditText"
                                android:layout_width="80dp"
                                android:layout_height="48dp"
                                android:background="@drawable/input_background"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:hint="0"
                                android:textColorHint="@color/colorInputHint"
                                android:inputType="numberDecimal"
                                android:maxLength="5"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium"
                                android:textAlignment="center"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/discount_percent"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="8dp"
                                android:paddingEnd="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/finalPriceLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/row_item_background"
                        android:padding="14dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/finalPriceLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/final_price"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/finalPriceValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorPositive"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Comment Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <CheckBox
                        android:id="@+id/addCommentCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comment"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="44dp"
                        app:buttonTint="@color/colorPrimary" />

                    <EditText
                        android:id="@+id/commentEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:background="@drawable/input_background"
                        android:padding="16dp"
                        android:hint="@string/comment_hint"
                        android:textColorHint="@color/colorInputHint"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:gravity="top|start"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Progress Indicator -->
                <ProgressBar
                    android:id="@+id/progress_circular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="gone" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/sendTransactionButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/insert"
                    android:textColor="@color/colorWhite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_primary" />

            </LinearLayout>

            <!-- AdView Banner -->
            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:adSize="BANNER"
                app:adUnitId="@string/admob_banner_unit_id" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
